{
  "name": "riftbound-arena",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n WEB,RELAY -c cyan,magenta \"npm:dev:web\" \"npm:dev:relay\"",
    "dev:web": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --host 0.0.0.0",
    "dev:relay": "node server/relay.mjs",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "concurrently -k \"npm:start:web\" \"npm:dev:relay\"",
    "start:web": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start --host 0.0.0.0",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.2.6",
    "phaser": "^4.2.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@rolldown/binding-win32-x64-msvc": "^1.0.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
